# ==============================================================================
# BEES-Recipes Configuration
# ==============================================================================

# Application Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_TITLE="BEES-Recipes Extraction API"
APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# Azure OpenAI / APIM Configuration
# ------------------------------------------------------------------------------
# Standard Azure OpenAI or APIM endpoint
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-azure-openai-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Optional APIM Azure OpenAI route. When both are set, APIM takes precedence.
# The APIM API requires an Ocp-Apim-Subscription-Key subscription key.
# The SDK appends /openai/ automatically; use the APIM gateway root.
# AZUREOPENAI_APIM_API_ENDPOINT=https://dcs-apim-d-we-002.azure-api.net
# AZUREOPENAI_APIM_API_KEY=replace-with-apim-subscription-key
# APIM_SUBSCRIPTION_KEY_HEADER=api-key

# Optional custom APIM header if required by the gateway

# Alternative naming support matching Bees.Chatbot.Internal:
# AZUREOPENAI_APIM_API_ENDPOINT=https://...
# AZUREOPENAI_APIM_API_KEY=...
# AZUREOPENAI_API_LLM=gpt-4o
# AZUREOPENAI_API_VERSION=2024-08-01-preview

# ------------------------------------------------------------------------------
# Azure Cosmos DB Configuration
# ------------------------------------------------------------------------------
# Cosmos DB endpoint (or COSMOS_DB_URL)
COSMOS_DB_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_DB_KEY=replace-with-cosmos-key
COSMOS_DB_DATABASE=recipes_db
COSMOS_DB_CONTAINER=recipes
COSMOS_DB_AUTO_SAVE=true

# Alternative naming matching internal services:
# COSMOS_DB_URL=https://...
# CHATBOT_DATABASE=recipes_db

# ------------------------------------------------------------------------------
# Optional Social & Scraping Settings
# ------------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=30.0
MAX_HTML_CHARS=15000

# Instagram optional credentials (only if accessing private posts or facing aggressive rate limits)
# INSTAGRAM_USERNAME=
# INSTAGRAM_PASSWORD=
